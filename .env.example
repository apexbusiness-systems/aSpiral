# Supabase Configuration
# Required: Get these from your Supabase project settings
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# WebGL Stage (R3F)
# - true (default): interactive 3D stage with camera controls
# - false: CSS/SVG fallback stage
VITE_ENABLE_WEBGL=true

# PostHog Analytics (Optional)
VITE_POSTHOG_KEY=your-posthog-key-here
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Edge Function Security (Server-side)
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
LOG_LEVEL=info

# Groq AI (required for chat, STT, and TTS)
GROQ_API_KEY=your_groq_api_key_here
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=austin

# CORS: Comma-separated allowed origins (set "*" to allow all, not recommended)
# Default fallback list includes Cloudflare Pages and local dev servers
ALLOWED_ORIGINS=https://aspiral.pages.dev,https://app.apex-business.com,http://localhost:3000,http://localhost:5173,http://localhost:8080

# Build Configuration
NODE_ENV=production

# Hosting: Cloudflare Pages
# Build command: npm run build (or npm run pages:build)
# Output directory: dist
# Node.js version: 22.x (set in Cloudflare dashboard or .node-version)
# SPA routing handled by public/_redirects
