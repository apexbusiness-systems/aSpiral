# Supabase Configuration
# Required: Get these from your Supabase project settings
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# WebGL Stage (R3F)
# - true (default): interactive 3D stage with camera controls
# - false: CSS/SVG fallback stage
VITE_ENABLE_WEBGL=true

# PostHog Analytics (Optional)
VITE_POSTHOG_KEY=your-posthog-key-here
VITE_POSTHOG_HOST=https://app.posthog.com

# Edge Function Security (Server-side)
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview-2024-10-01
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://app.apex-business.com
LOG_LEVEL=info

# Build Configuration
NODE_ENV=production
